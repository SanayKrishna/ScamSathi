# Backend base URL (FastAPI). CORS on the backend allows http://localhost:5173.
VITE_API_URL=http://localhost:8000
# true = serve responses from src/mocks/ (no backend needed). false = live backend.
VITE_USE_MOCKS=true
# Product name shown in the top bar.
VITE_PRODUCT_NAME=ScamSathi
# Persona display name. Rename here only, never hardcode it.
VITE_PERSONA_NAME=Ajji
