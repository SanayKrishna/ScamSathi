# ── Hindsight (memory) ─────────────────────────────────────────
# Cloud:       HINDSIGHT_URL=https://api.hindsight.vectorize.io
# Self-hosted: HINDSIGHT_URL=http://localhost:8888
HINDSIGHT_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=scam-intel
HINDSIGHT_TIMEOUT_SECONDS=8
HINDSIGHT_MAX_ATTEMPTS=2

# ── Groq (extraction + Ajji's replies) ─────────────────────────
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=10

# ── App ────────────────────────────────────────────────────────
PERSONA_NAME=Ajji
TURN_TIMEOUT_SECONDS=8
DB_PATH=./ajji.db
# Comma separated. The Vite dev server is 5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Demo seed ──────────────────────────────────────────────────
# The seed job talks to the running API over HTTP.
SEED_BASE_URL=http://127.0.0.1:8000
SEED_CONVERSATIONS=20
SEED_USE_LLM=true
SEED_DELAY_SECONDS=1
SEED_TIMEOUT_SECONDS=120
